# ===================== 应用配置 =====================
APP_HOST=0.0.0.0
APP_PORT=8113
APP_DEBUG=False
ENVIRONMENT=development

# ===================== PLC 配置 =====================
PLC_IP=192.168.0.205
PLC_PORT=102

# ===================== 离心机配置 =====================
CENTRIFUGE_HOST=192.168.0.140
CENTRIFUGE_PORT=8000
CENTRIFUGE_TIMEOUT=5
CENTRIFUGE_SUB_ADDR=tcp://127.0.0.1:49203
CENTRIFUGE_REQ_ADDR=tcp://127.0.0.1:49204

# ===================== 玻璃门配置 =====================
DOOR_TARGET_ADDRESS=tcp://127.0.0.1:49202

# ===================== 高温炉配置 =====================
FURNACE_REQ_ADDR=tcp://127.0.0.1:49206
FURNACE_SUB_ADDR=tcp://127.0.0.1:49200
FURNACE_CTRL_ADDR=tcp://127.0.0.1:49201

# ===================== 高温炉曲线点地址配置 =====================
FURNACE_DB_PATH=assets/oven_curve.sqlite

# ===================== 配料设备配置 =====================
MIXER_API_BASE_URL=http://127.0.0.1:4669
MIXER_USERNAME=admin
MIXER_PASSWORD=admin
MIXER_TIMEOUT=30

# ===================== XRD设备配置 =====================
XRD_HOST=192.168.8.127
XRD_PORT=8009
XRD_TIMEOUT=5

# ===================== 日志配置 =====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ===================== 本地测试（无设备 Mock 模式）=====================
# 设为 true 时启动不连接设备，实验流程中配料/热处理/XRD 仅模拟成功，用于本地完整跑通 API
MOCK_DEVICES=true
MOCK_STEP_DELAY=1.0
# 燃烧等待时间上限（秒），0=不设上限。Mock 时建议 30，避免真实曲线数天导致长时间阻塞
BURN_WAIT_CAP_SEC=30
# XRD 等待时间上限（秒），0=不设上限。Mock 时建议 10~20，避免等待测试完成/升压/电压稳定长时间阻塞
XRD_WAIT_CAP_SEC=20